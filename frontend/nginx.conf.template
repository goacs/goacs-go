# Templated by the official nginx image's docker-entrypoint (envsubst) at container
# start into /etc/nginx/conf.d/default.conf. BACKEND_HOST defaults to the conventional
# docker-compose service name for the goacs backend container; override with
# `-e BACKEND_HOST=host:port` if it's deployed elsewhere.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve BACKEND_HOST at request time (via Docker's embedded DNS) rather than at
    # config load, so this container starts even if the backend isn't up/resolvable yet.
    resolver 127.0.0.11 valid=10s;
    set $backend "${BACKEND_HOST}";

    location /api/ {
        proxy_pass http://$backend/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket.io/ {
        proxy_pass http://$backend/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
